# Copia este archivo como .env y pon los datos de tu proyecto (Supabase → Project Settings → API Keys)
# Usa SOLO la publishable key (sb_publishable_...). Nunca la secret key: el juego corre en el navegador.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
